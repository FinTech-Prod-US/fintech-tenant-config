# Ignore Python cache and local tool artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Ignore virtual environments
.venv/
venv/

# Ignore IDE files
.vscode/
.idea/

# Ignore SOPS backup files
*.sops.yaml
*.sops.json

# But keep the repo's own SOPS config
!.sops.yaml

# NOTE: secrets.json may be committed ONLY if encrypted with SOPS.
# validate.py rejects plaintext secrets.json to prevent accidental commits.
